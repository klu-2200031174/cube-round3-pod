# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (hosted project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by scripts/seed.ts and scripts/test-rls.ts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Which vision model: "gemini" (default: local runs, eval, deployment) or "ollama" (offline fallback)
VISION_PROVIDER=gemini

# Ollama vision model (optional offline fallback: ollama pull llava). Slow on CPU: 1-7 min per unit.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llava
# Model call timeout in ms. On timeout the record is saved as `pending` (fail open).
OLLAMA_TIMEOUT_MS=600000

# Gemini (Google AI Studio → Get API key). Free tier: Google may use content to improve its products.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=120000

# Password for the two demo operators created by `npm run seed`
# (alpha.operator@demo.test → org_demo_alpha, bravo.operator@demo.test → org_demo_bravo)
DEMO_PASSWORD=choose-a-long-password
